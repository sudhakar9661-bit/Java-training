import java.io.*;
import java.util.*;

public class Solution 
{
    public static void main(String args[])
    {
        int sum1,sum2,c,d,e,f;
        Scanner il =new Scanner(System.in);
        sum1 = il.nextInt();
        sum2 = il.nextInt();
        c=sum1+sum2;
        d=sum1-sum2;
        e=sum1*sum2;
        f=sum1/sum2;
        System.out.println(c+"\n"+d+"\n"+e+"\n"+f);
    }
}
