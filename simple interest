import java.io.*;
import java.util.*;

public class Solution 
{
    public static void main(String args[])
    {
        int p,r,t,sum;
        Scanner il=new Scanner(System.in);
        p=il.nextInt();
        r=il.nextInt();
        t=il.nextInt();
        sum=((p*r*t)/100);
        System.out.println(sum);
    }
}
