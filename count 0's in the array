import java.util.*;
public class Main
{
    public static void main(String args[])
    {
        int n;
        Scanner sc=new Scanner(System.in);
        n=sc.nextInt();
        int arr[]=new int [10];
        for(int i=0;i<n;i++)
        {
            arr[i]=sc.nextInt();
        }
        int Count =0;
        for(int i=0;i<n;i++)
        {
            if(arr[i]==0)
            {
                Count++;
            }
       } 
       System.out.print(Count);
    } 
}
